views:
  - type: cards
    name: HOME
    filters:
      and:
        - file.hasTag("notes")
        - file.inFolder("austin/Synced Folder/Journal")
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - file.tags
    sort:
      - property: file.name
        direction: ASC
    cardSize: 90
    imageAspectRatio: 1.45
    image: note.cover
